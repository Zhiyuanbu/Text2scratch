{
  "name": "text2scratch",
  "version": "1.0.0",
  "private": true,
  "description": "`text2scratch` is a static web app that converts text commands into Scratch 3 projects (`.sb3`) and can reverse-import existing Scratch projects back into editable text syntax.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/site src/api.ts vite.config.ts config --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:high": "npm audit --audit-level=high",
    "analyze": "cross-env ANALYZE=true vite build",
    "prepare": "simple-git-hooks",
    "next:dev": "npm --prefix apps/next-site run dev",
    "next:build": "npm --prefix apps/next-site run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhiyuanbu/Text2scratch.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Zhiyuanbu/Text2scratch/issues"
  },
  "homepage": "https://github.com/Zhiyuanbu/Text2scratch#readme",
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@supabase/supabase-js": "^2.98.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "scratchblocks": "^3.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.21",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^5.14.0",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm run test"
  }
}
